include mixins.pug
include ../util.pug

link(rel="stylesheet" href="../../style/weapons-list.css")

head
    meta(charset="UTF-8")
body
    table
        tr
            th(rowspan="2") Name
            th(rowspan="2") Cost
            th Weight
            th(rowspan="2") Size
            th(rowspan="2") Type
            th(rowspan="2") Speed
            th Melee
            th Missile
            th(colspan="3" class="center") Range
            th(colspan="2" class="center") Damage
            th(rowspan="2") Knockdown
            th(colspan=3 class="center") Weapon Proficiency
            th(rowspan="2") Source
        tr
            th (lbs.)
            th Reach
            th ROF
            th S
            th M
            th L
            th Sm-Med
            th Large
            th Single
            th Related / Familiar / Tight Group
            th Broad Group
        - let color
        each book in bookPriority
            - let indents = 0
            - let weapon = weaponObj[book.id]
            if weapon
                - color = colorFlip(color)
                +weaponRow(weapon, book, color, indents)
            - indents = 1;
            each hand in handedness
                - let grip = weaponObj.grip?.[hand.id]?.[book.id]
                if grip
                    +weaponRow(grip, book, color, indents)
            if weaponObj.ammunition
                each ammoType in weaponObj.ammunition
                    - let ammo = ammoType[book.id]
                    if ammo
                        +weaponRow(ammo, book, color, indents)
    - let usedEntries = {}
    each book in bookPriority
        - let weapon = weaponObj[book.id]
        if weapon
            if weapon.descriptions
                +descriptionEntries(weapon.descriptions, book, usedEntries)
            if weapon.comment
                +comments(weapon, book, usedEntries)
        each hand in handedness
            - let grip = weaponObj.grip?.[hand.id]?.[book.id]
            if grip && grip.descriptions
                +descriptionEntries(grip.descriptions, book, usedEntries)
        if weaponObj.ammunition
            each ammoType in weaponObj.ammunition
                - let ammo = ammoType[book.id]
                if ammo
                    if ammo.descriptions
                        +descriptionEntries(ammo.descriptions, book, usedEntries)
                    if ammo.comment
                        +comments(ammo, book, usedEntries)
    each book in bookPriority
        - let weapon = weaponObj[book.id]
        if weapon && weapon.images
            each imgObj in weapon.images
                p
                    span(class="title") #{book.title} p. #{imgObj.pages.join(', ')}
                    br
                    img(src="../../img/weapons/"+imgObj.image)