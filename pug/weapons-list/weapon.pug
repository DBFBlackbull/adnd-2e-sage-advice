include mixins.pug

head
    meta(charset="UTF-8")
body
    table
        tr(class="gray")
            th(rowspan="2") Name
            th(rowspan="2") Cost
            th Weight
            th(rowspan="2") Size
            th(rowspan="2") Type
            th(rowspan="2") Speed
            th Melee
            th Missile
            th(colspan="3") Range
            th(colspan="2") Damage
            th(colspan="2") Knockdown
        tr
            th (lbs.)
            th Reach
            th ROF
            th S
            th M
            th L
            th Sm-Med
            th Large
        each book in bookPriority
            - let weapon = weaponObj[book.id]
            if weapon
                tr
                    td !{weapon.name}
                    td !{getCost(weapon.cost)}
                    td !{weapon.weight_lbs}
                    td !{weapon.size.id}
                    td !{getType(weaponType)}
                    td !{weapon.speed}
                    td !{getRateOfFire(weapon.rate_of_fire)}
                    td !{getRangeShort(weapon.range)}
                    td !{getRangeMedium(weapon.range)}
                    td !{getRangeLong(weapon.range)}
                    td !{getDamageSmallMedium(weapon.damage)}
                    td !{getDamageLarge(weapon.damage)}
