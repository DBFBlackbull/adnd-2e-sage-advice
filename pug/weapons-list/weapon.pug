include mixins.pug

link(rel="stylesheet" href="../../style/weapons-list.css")

head
    meta(charset="UTF-8")
body
    table
        tr
            th(rowspan="2") Name
            th(rowspan="2") Cost
            th Weight
            th(rowspan="2") Size
            th(rowspan="2") Type
            th(rowspan="2") Speed
            th Melee
            th Missile
            th(colspan="3" class="center") Range
            th(colspan="2" class="center") Damage
            th(rowspan="2") Knockdown
        tr
            th (lbs.)
            th Reach
            th ROF
            th S
            th M
            th L
            th Sm-Med
            th Large
        each book in bookPriority
            - let weapon = weaponObj[book.id]
            if weapon
                tr
                    td !{weapon.name}
                    td !{getCost(weapon.cost)}
                    td !{weapon.weight_lbs}
                    td !{weapon.size.id}
                    td !{getType(weapon.type)}
                    td !{getProp(weapon.speed)}
                    td !{getProp(weapon.melee_reach)}
                    td !{getProp(weapon.rate_of_fire)}
                    td !{getRangeShort(weapon.range)}
                    td !{getRangeMedium(weapon.range)}
                    td !{getRangeLong(weapon.range)}
                    td !{getDamageSmallMedium(weapon.damage)}
                    td !{getDamageLarge(weapon.damage)}
            each hand in handedness
                - let grip = weaponObj.grip?.[hand.id]?.[book.id]
                if grip
                    tr
                        td &emsp;!{grip.name}
                        td —
                        td —
                        td —
                        td —
                        td !{getProp(grip.speed)}
                        td —
                        td !{getProp(grip.rate_of_fire)}
                        td !{getRangeShort(grip.range)}
                        td !{getRangeMedium(grip.range)}
                        td !{getRangeLong(grip.range)}
                        td !{getDamageSmallMedium(grip.damage)}
                        td !{getDamageLarge(grip.damage)}
