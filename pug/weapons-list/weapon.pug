head
    meta(charset="UTF-8")
body
    table
        tr(class="gray")
            th(rowspan="2") Name
            th(rowspan="2") Cost
            th Weight
            th(rowspan="2") Size
            th(rowspan="2") Type
            th(rowspan="2") Speed
            //th Melee
            th Missile
            th(colspan="3") Range
            th(colspan="2") Damage
            //th(colspan="2") Knockdown
        tr
            th (lbs.)
            //th Reach
            th ROF
            th S
            th M
            th L
            th Sm-Med
            th Large
        each book in bookPriority
            - let weapon = weaponObj[book]
            if weapon
                tr
                    td !{weapon.name}
                    td !{weapon.cost.string()}
                    td !{weapon.weight_lbs}
                    td !{weapon.size.id}
                    td !{weapon.type.join("/")}
                    td !{weapon.speed}
                    td !{weapon.rate_of_fire}
                    td !{weapon.range.short}
                    td !{weapon.range.medium}
                    td !{weapon.range.long}
                    td !{weapon.damage.small_medium}
                    td !{weapon.damage.large}
