-
    function getProp(prop) {
        if (!prop) {
            return '—';
        }

        return prop;
    }

    function getCost(cost) {
        if (!cost) {
            return '—';
        }

        let displayString = `${cost.amount} ${cost.currency.id}`;
        if (cost.quantity && cost.quantity > 1) {
            displayString += `/${cost.quantity}`
        }
        return displayString;
    }

    function getSize(size) {
        if (!size) {
            return '—';
        }

        return size.id;
    }

    function getType(type) {
        if (!type) {
            return '—';
        }

        if (Array.isArray(type)) {
            return type.map(t => t.id).join('/')
        }

        return type.id
    }

    function getRangeShort(range) {
        if (!range?.short) {
            return '—'
        }

        return range.short
    }

    function getRangeMedium(range) {
        if (!range?.medium) {
            return '—'
        }

        return range.medium
    }

    function getRangeLong(range) {
        if (!range?.long) {
            return '—'
        }

        return range.long
    }

    function getDamageSmallMedium(damage) {
        if (!damage?.small_medium) {
            return '—';
        }

        return damage.small_medium
    }

    function getDamageLarge(damage) {
        if (!damage?.large) {
            return '—';
        }

        return damage.large
    }

    function getSingleProf(proficiencies) {
        if (!proficiencies?.single) {
            return '—';
        }

        return proficiencies.single
    }

    function getTightGroupProf(proficiencies) {
        if (proficiencies?.related) {
            return proficiencies.related.join(", ");
        }

        if (proficiencies?.tight) {
            return proficiencies.tight.map(t => t.name).join(", ");
        }

        return '—';
    }

    function getBroadGroupProf(proficiencies) {
        if (!proficiencies?.broad) {
            return '—';
        }

        return proficiencies.broad.map(b => b.name).join(", ");
    }

    function getSource(pages, book) {
        if (!pages) {
            console.log("pages is missing")
        }

        return `${book.title} p. ${pages.join(', ')}`
    }

    function colorFlip(color) {
        if (color === '') {
            return 'antiquewhite';
        }

        return '';
    }

mixin weaponRow(obj, book, color, indents)
    - let indent = '&emsp;'.repeat(indents)
    - let backgroundColor = `background: ${color};`
    tr(style=backgroundColor)
        - if (!obj.name) { console.log(`${book.id} ${obj.id} is missing name`) }
        - let footnoteMarker = obj.footnote_marker ? ` ${obj.footnote_marker}` : ""
        td !{indent + obj.name + footnoteMarker}
        td !{getCost(obj.cost)}
        td !{getProp(obj.weight_lbs)}
        td !{getSize(obj.size)}
        td !{getType(obj.type)}
        td !{getProp(obj.speed)}
        td !{getProp(obj.melee_reach)}
        td !{getProp(obj.rate_of_fire)}
        td !{getRangeShort(obj.range)}
        td !{getRangeMedium(obj.range)}
        td !{getRangeLong(obj.range)}
        td !{getDamageSmallMedium(obj.damage)}
        td !{getDamageLarge(obj.damage)}
        td !{getProp(obj.knockdown)}
        td !{getSingleProf(obj.proficiencies)}
        td !{getTightGroupProf(obj.proficiencies)}
        td !{getBroadGroupProf(obj.proficiencies)}
        td !{getSource(obj.pages, book)}

mixin descriptionEntries(descriptions, book, usedEntries)
    each entry in descriptions
        if usedEntries[entry.text.toString()]
            - continue
        p
            span(class="title") #{book.title} p. #{entry.pages.join(', ')}
            br
            span(class="entry") !{formatInput(entry.text, book.id, entry.pages)}
            - usedEntries[entry.text.toString()] = true
            if entry.optional
                br
                span(class="optional") &emsp;!{formatInput(entry.optional, book.id, entry.pages)}
            if entry.comment
                span(class="comment")
                    strong
                        em Comment:
                    |  !{formatInput(entry.comment, book.id, entry.pages)}